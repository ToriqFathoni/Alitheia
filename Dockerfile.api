# ==============================================================================
# Dockerfile.api — Alitheia Express API (Ubuntu 24.04 + Node 22 LTS)
# ==============================================================================
# Multi-stage build:
#   base   → Ubuntu 24.04 + Node.js 22
#   deps   → npm ci (production + dev for build)
#   builder→ prisma generate + tsc
#   runner → minimal production image
# ==============================================================================

# ---------- Stage 1: base ----------
FROM node:22-bookworm-slim AS base

# OpenSSL is needed by Prisma at runtime.
RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---------- Stage 2: deps ----------
FROM base AS deps

# Copy workspace root manifests
COPY package.json package-lock.json turbo.json ./

# Copy every workspace package.json (preserving directory structure)
COPY apps/api/package.json ./apps/api/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json

# We need the web workspace package.json too so npm workspaces resolves correctly
COPY apps/web/package.json ./apps/web/package.json

# Install ALL dependencies (including devDependencies needed for build)
RUN npm ci

# ---------- Stage 3: builder ----------
FROM deps AS builder

# Copy source code
COPY packages/config/ ./packages/config/
COPY packages/shared-types/ ./packages/shared-types/
COPY packages/database/ ./packages/database/
COPY apps/api/ ./apps/api/

# Generate Prisma client
RUN npx prisma generate --schema=packages/database/prisma/schema.prisma

# Keep the API compiler on the supported TypeScript 5 toolchain. The existing
# lockfile can resolve a prerelease TypeScript package without its Linux binary.
RUN npm install --workspace=apps/api --no-save --package-lock=false typescript@5.9.3

# Build shared TypeScript declarations before compiling the API.
RUN npm run build --workspace=packages/shared-types

# Build the database package
RUN npm run build --workspace=packages/database 2>/dev/null || true

# Build the API
RUN npm run build --workspace=apps/api

# ---------- Stage 4: runner ----------
FROM base AS runner

ENV NODE_ENV=production

WORKDIR /app

# Copy workspace root manifests
COPY package.json package-lock.json turbo.json ./

# Copy every workspace package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json

# Install production-only deps
RUN npm ci --omit=dev

# Prisma CLI is a devDependency, so `npm ci --omit=dev` does not install it.
# Install it in an isolated prefix (pinned to the project's Prisma 5.22) so the
# container can sync the schema on startup without downloading anything at runtime.
RUN mkdir -p /opt/prisma-cli && \
    cd /opt/prisma-cli && \
    npm init -y >/dev/null 2>&1 && \
    npm install --no-audit --no-fund prisma@5.22.0

# Copy Prisma schema + migrations (needed for `prisma db push` at startup)
COPY packages/database/prisma/ ./packages/database/prisma/

# Copy generated Prisma client from builder
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client

# Copy built artifacts
COPY --from=builder /app/apps/api/dist/ ./apps/api/dist/
COPY --from=builder /app/packages/config/ ./packages/config/
COPY --from=builder /app/packages/database/dist/ ./packages/database/dist/
COPY --from=builder /app/packages/shared-types/dist/ ./packages/shared-types/dist/

# Runtime assets that tsc does not emit into dist/:
#  - data/Data_latih.csv  -> training dataset (few-shot RAG + DB seeding)
#  - hoax-detection.v1.md -> LLM prompt template, resolved by the orchestrator at
#    <cwd>/apps/api/src/modules/orchestrator/prompts/
COPY data/ ./data/
COPY apps/api/src/modules/orchestrator/prompts/ ./apps/api/src/modules/orchestrator/prompts/

EXPOSE 5000

# Entrypoint: sync the DB schema, then start the API server.
#
# `db push` is used (same as the README dev flow) instead of `migrate deploy`:
# the migration history does not create `data_latih_berita`, and a database
# that was created with `db push` has no _prisma_migrations baseline, so
# `migrate deploy` would fail with P3005. `db push` is idempotent and works for
# both fresh and existing databases. If it fails, the container exits loudly
# instead of silently falling back to the API's in-memory store.
CMD ["sh", "-c", "/opt/prisma-cli/node_modules/.bin/prisma db push --skip-generate --schema=packages/database/prisma/schema.prisma && node apps/api/dist/index.js"]
