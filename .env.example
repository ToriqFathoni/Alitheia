# ==============================================================================
# ALITHEIA ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env dan sesuaikan nilai rahasia (secrets).
# File .env lokal di-ignore oleh Git untuk keamanan.

# --- App & Server ---
NODE_ENV=development
PORT=5000
WEB_PORT=3000
LOG_LEVEL=info

# --- CORS ---
# Domain frontend yang diizinkan memanggil backend API (pisahkan dengan koma jika multiple)
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---
# Default port 5431 untuk menghindari bentrok dengan PostgreSQL lokal (5432) dan dynamic range Windows (5433+)
DATABASE_URL="postgresql://alitheia:alitheia_secret@localhost:5431/alitheia?schema=public"

# --- Cache & Background Job (Redis) ---
REDIS_URL="redis://localhost:6379"

# --- Security & Auth ---
JWT_SECRET="alitheia-dev-secret-key-change-in-production-min-32-chars"

# --- Ingestion & Orchestration Limits ---
MAX_INPUT_WORDS=15000
EXTERNAL_TIMEOUT_MS=15000

# --- LLM API Providers (Primary: Gemini, Fallback: 9Router) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_RATE_LIMIT_COOLDOWN_MS=60000

NINEROUTER_BASE_URL="http://localhost:20128/v1"
NINEROUTER_API_KEY=""
NINEROUTER_MODEL="gpt-4o-mini"

# --- Training Dataset & FIFO Queue ---
MAX_TRAINING_DATA_ROWS=5000
TRAINING_CSV_PATH="data/Data_latih.csv"

# --- External Fact-Check APIs (Opsional) ---
FACTCHECK_API_KEY=""
