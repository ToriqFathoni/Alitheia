# ==============================================================================
# ALITHEIA ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env dan sesuaikan nilai rahasia (secrets).
# File .env lokal di-ignore oleh Git untuk keamanan.

# --- App & Server ---
NODE_ENV=development
PORT=5000
WEB_PORT=3000
LOG_LEVEL=info

# --- CORS ---
# Domain frontend yang diizinkan memanggil backend API (pisahkan dengan koma jika multiple)
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---
# Default port 5433 untuk menghindari bentrok dengan PostgreSQL lokal mesin Windows
DATABASE_URL="postgresql://alitheia:alitheia_secret@localhost:5433/alitheia?schema=public"

# --- Cache & Background Job (Redis) ---
REDIS_URL="redis://localhost:6379"

# --- Security & Auth ---
JWT_SECRET="alitheia-dev-secret-key-change-in-production-min-32-chars"

# --- Ingestion & Orchestration Limits ---
MAX_INPUT_WORDS=15000
EXTERNAL_TIMEOUT_MS=8000

# --- External AI & Fact-Check APIs (Opsional untuk Langkah Awal) ---
GEMINI_API_KEY=""
FACTCHECK_API_KEY=""
