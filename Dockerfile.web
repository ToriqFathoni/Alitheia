# ==============================================================================
# Dockerfile.web — Alitheia Next.js Frontend (Ubuntu 24.04 + Node 22 LTS)
# ==============================================================================
# Multi-stage build:
#   base   → Ubuntu 24.04 + Node.js 22
#   deps   → npm ci (all dependencies)
#   builder→ next build (standalone output)
#   runner → minimal production image with standalone server
# ==============================================================================

# ---------- Stage 1: base ----------
FROM node:22-bookworm-slim AS base

WORKDIR /app

# ---------- Stage 2: deps ----------
FROM base AS deps

# Copy workspace root manifests
COPY package.json package-lock.json turbo.json ./

# Copy every workspace package.json (preserving directory structure)
COPY apps/web/package.json ./apps/web/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json

# Install ALL dependencies (dev included — needed for build tooling). The
# Lightning CSS Linux binary is installed explicitly because npm ci can omit
# platform-specific optional packages when the lockfile was created elsewhere.
RUN npm ci --include=optional && \
	npm install --no-save --package-lock=false lightningcss-linux-x64-gnu@1.32.0

# ---------- Stage 3: builder ----------
FROM deps AS builder

# Copy all source code
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# Build Next.js (standalone output)
RUN npm run build --workspace=apps/web

# ---------- Stage 4: runner ----------
FROM base AS runner

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

WORKDIR /app

# Copy standalone server output
COPY --from=builder /app/apps/web/.next/standalone/ ./

# Copy static assets (not included in standalone)
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static

# Copy public assets
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
